// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Side {
  long 
  short 
}
enum CloseReason { 
  stop 
  target 
  manual 
}

model Settings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalance Decimal  @map("starting_balance") @db.Decimal(20, 8)
  currency        String
  maxRiskPct      Decimal  @map("max_risk_pct") @db.Decimal(7, 4)
  strategies      String[] @default([])
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model Trade {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pair       String
  side       Side
  entry      Decimal  @db.Decimal(20, 8)
  stop       Decimal  @db.Decimal(20, 8)
  target     Decimal? @db.Decimal(20, 8)
  size       Decimal  @db.Decimal(20, 8)
  riskPct    Decimal  @map("risk_pct") @db.Decimal(7, 4)
  riskAmount Decimal  @map("risk_amount") @db.Decimal(20, 8)
  fees       Decimal  @default(0) @db.Decimal(20, 8)
  strategy   String?
  timeframe  String?
  notes      String?
  imageUrl   String?  @map("image_url")
  openedAt   DateTime @map("opened_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  closes     Close[]

  @@index([userId, openedAt(sort: Desc)])
  @@map("trades")
}

model Close {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId   String      @map("trade_id") @db.Uuid
  trade     Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  percent   Decimal     @db.Decimal(12, 8) // % of the ORIGINAL size
  price     Decimal     @db.Decimal(20, 8)
  reason    CloseReason
  fees      Decimal     @default(0) @db.Decimal(20, 8)
  mistake   String?
  note      String?
  imageUrl  String?     @map("image_url")
  closedAt  DateTime    @map("closed_at") @db.Timestamptz
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([tradeId])
  @@index([userId])
  @@map("closes")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  settings      Settings?
  trades        Trade[]
  closes        Close[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Side {
  long 
  short 
}
enum CloseReason { 
  stop 
  target 
  manual 
}

model Settings {
  id              Int      @id @default(1)           // single row, enforced by a CHECK (see below)
  startingBalance Decimal  @map("starting_balance") @db.Decimal(20, 8)
  currency        String
  maxRiskPct      Decimal  @map("max_risk_pct") @db.Decimal(7, 4)
  strategies      String[] @default([])
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@map("settings")
}

model Trade {
  id         String   @id @default(uuid()) @db.Uuid
  pair       String
  side       Side
  entry      Decimal  @db.Decimal(20, 8)
  stop       Decimal  @db.Decimal(20, 8)
  target     Decimal? @db.Decimal(20, 8)
  size       Decimal  @db.Decimal(20, 8)
  riskPct    Decimal  @map("risk_pct") @db.Decimal(7, 4)
  riskAmount Decimal  @map("risk_amount") @db.Decimal(20, 8)
  fees       Decimal  @default(0) @db.Decimal(20, 8)
  strategy   String?
  timeframe  String?
  notes      String?
  imageUrl   String?  @map("image_url")
  openedAt   DateTime @map("opened_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  closes     Close[]

  @@index([openedAt(sort: Desc)])
  @@map("trades")
}

model Close {
  id        String      @id @default(uuid()) @db.Uuid
  tradeId   String      @map("trade_id") @db.Uuid
  trade     Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  percent   Decimal     @db.Decimal(12, 8)          // % of the ORIGINAL size
  price     Decimal     @db.Decimal(20, 8)
  reason    CloseReason
  fees      Decimal     @default(0) @db.Decimal(20, 8)
  mistake   String?
  note      String?
  imageUrl  String?     @map("image_url")
  closedAt  DateTime    @map("closed_at") @db.Timestamptz
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([tradeId])
  @@map("closes")
}